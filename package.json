{
  "name": "cycle-gtm-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cycle — scrape leads, AI email/LinkedIn outreach, auto follow-ups",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "seed": "node -e \"import('./server/seed.js').then(m=>m.seedIfEmpty(true))\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nodemailer": "^6.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
